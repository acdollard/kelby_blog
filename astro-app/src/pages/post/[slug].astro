---
import type { InferGetStaticParamsType } from "astro";
import { PortableText } from "astro-portabletext";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../utils";
import { urlFor } from "../../utils/image";
import { getPost, getPosts } from "../../utils/sanity";
import PortableTextImage from "../../components/PortableTextImage.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

const components = {
  type: {
    image: PortableTextImage,
  },
};

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;

const post = await getPost(slug);
---

<Layout title={post.title!}>
  <section class="post">
    {
      post.mainImage ? (
        <img
          class="post__cover"
          src={urlFor(post.mainImage).url()}
          alt="Cover image"
        />
      ) : (
        <div class="post__cover--none" />
      )
    }
    <div class="post__container">
      <h1 class="post__title">{post.title}</h1>
      <p class="post__excerpt">{post.excerpt}</p>
      <p class="post__date">
        {formatDate(post._createdAt)}
      </p>
      <div class="post__content">
        <PortableText value={post.body} components={components} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .post {
    max-width: var(--max-width-1);
    width: 100%;
    margin: 0 auto;
    margin-top: var(--space-8);
    padding: 0 var(--page-padding-inline);
    display: flex;
    flex-direction: column;
    align-items: stretch;

    & .post__cover,
    & .post__cover--none {
      width: 100%;
      max-width: 100%;
      height: auto;
      max-height: 240px;
      object-fit: contain;
    }

    & .post__cover--none {
      background: var(--black);
      min-height: 200px;
    }

    & .post__container {
      width: 100%;
      max-width: 100%;
    }

    & .post__content {
      font-family: var(--font-family-serif);
      font-weight: 400;
      font-size: var(--font-clamp-post-body);
      line-height: 1.6;
      letter-spacing: -0.02em;
      margin-top: var(--space-6);
      color: var(--black);
      overflow-wrap: break-word;
      word-break: break-word;

      /* Targeting tags in PortableText */
      & :global(img),
      & :global(picture),
      & :global(picture img) {
        max-width: 100%;
        height: auto;
      }

      & blockquote {
        border-left: 5px solid var(--black);
        padding-left: var(--space-3);
        margin-left: 0;
        margin-right: 0;
      }

      & a {
        color: var(--blue-600);
        text-decoration: none;
        overflow-wrap: anywhere;
      }
    }

    & .post__title {
      font-family: var(--font-family-sans);
      font-size: var(--font-clamp-post-title);
      line-height: 1.15;
      margin: var(--space-4) 0;
      font-weight: 400;
      color: var(--color-primary);
      overflow-wrap: break-word;
      hyphens: auto;
    }

    & .post__excerpt {
      font-family: var(--font-family-serif);
      font-size: var(--font-clamp-post-excerpt);
      line-height: 1.45;
      margin-top: 0;
      font-weight: 400;
      overflow-wrap: break-word;
    }

    & .post__date {
      font-family: var(--font-family-sans);
      font-weight: 600;
      font-size: clamp(0.875rem, 1vw + 0.5rem, 1.125rem);
      line-height: 1.4;
      margin-top: var(--space-4);
    }
  }

  @media (min-width: 800px) {
    .post {
      & .post__cover,
      & .post__cover--none {
        max-height: none;
      }

      & .post__title {
        margin: var(--space-6) 0 0;
        letter-spacing: -0.025em;
      }

      & .post__excerpt {
        margin-top: var(--space-3);
        margin-bottom: var(--space-3);
      }

      & .post__date {
        margin-top: var(--space-0);
      }

      & .post__content {
        margin-top: var(--space-7);

        & blockquote {
          margin-left: var(--space-4);
        }
      }
    }
  }
</style>
